{
  "name": "@sagae/loupe",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build && node scripts/check-dist.mjs",
    "typecheck": "tsc -p .",
    "mock": "node dev/kb-mock/main.ts",
    "serve": "node bin/loupe.mjs serve",
    "status": "node bin/loupe.mjs status",
    "test": "vitest run",
    "contract:fixtures": "node scripts/validate-fixtures.ts",
    "contract:check": "node scripts/check-spec.ts",
    "contract:gen": "orval --config orval.config.mjs && node scripts/stamp.ts",
    "contract:types": "tsc -p . --pretty false",
    "contract:client": "vitest run test/client.test.ts test/mock.test.ts",
    "contract:schemathesis": "bash scripts/schemathesis.sh",
    "contract:flow": "bash scripts/contract-flow.sh",
    "contract:guard": "node scripts/contract-guard.mjs",
    "fixtures:build": "node contract-sample/fixtures/build-kb.mjs && node contract-sample/fixtures/research/build.mjs && node contract-sample/fixtures/hostile/build.mjs",
    "mock:research": "KB_FIXTURES=contract-sample/fixtures/kb-research.json node dev/kb-mock/main.ts",
    "mock:hostile": "KB_FIXTURES=contract-sample/fixtures/kb-hostile.json node dev/kb-mock/main.ts",
    "setup:schemathesis": "bash scripts/setup-schemathesis.sh",
    "setup:browsers": "PLAYWRIGHT_BROWSERS_PATH=.cache/ms-playwright playwright install chromium",
    "test:headless": "node scripts/e2e-headless.mjs",
    "setup:browser-libs": "bash scripts/setup-browser-libs.sh",
    "dev:mock": "node scripts/dev-mock.mjs",
    "test:e2e": "playwright test",
    "lint": "eslint src",
    "measure": "node scripts/measure-budgets.mjs",
    "check": "tsc -p . && eslint src && vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hono/node-server": "2.1.5",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-router": "1.170.46",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "hast-util-to-jsx-runtime": "2.3.6",
    "hono": "4.13.13",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "tw-animate-css": "1.4.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@fontsource/noto-sans-kr": "5.3.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/hast": "3.0.5",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "orval": "8.44.0",
    "playwright": "1.64.1",
    "shadcn": "4.22.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
