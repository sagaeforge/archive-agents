{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review",
  "x-kb-kind": "node",
  "x-kb-group": "user",
  "x-kb-overview": false,
  "x-kb-version": 1,
  "type": "object",
  "properties": {
    "target": {"type": "string", "maxLength": 256, "pattern": "^(?:c-[a-z0-9]+|r-[A-Za-z0-9._-]+|e:[a-z][a-z0-9_]*:[A-Za-z0-9._-]+)$"},
    "decision": {"enum": ["accept", "reject"]},
    "verdict": {"const": "reject"},
    "topic": {"type": "string", "pattern": "^e:topic:[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "note": {"type": "string", "maxLength": 500},
    "source_url": {"type": "string", "format": "uri", "pattern": "^https?://[^\\s]+$"}
  },
  "required": ["target"],
  "anyOf": [{"required": ["decision"]}, {"required": ["verdict"]}],
  "allOf": [
    {
      "if": {"required": ["verdict"]},
      "then": {
        "required": ["note"],
        "properties": {
          "decision": {"const": "reject"},
          "note": {"minLength": 1, "pattern": "\\S"},
          "target": {"pattern": "^c-[a-z0-9]+$"}
        }
      }
    },
    {"if": {"required": ["source_url"]}, "then": {"required": ["verdict"]}}
  ],
  "additionalProperties": false
}
