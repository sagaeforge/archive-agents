{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision",
  "x-kb-kind": "node",
  "x-kb-group": "user",
  "x-kb-overview": true,
  "x-kb-version": 1,
  "type": "object",
  "properties": {
    "status": {
      "enum": [
        "proposed",
        "accepted",
        "rejected",
        "deprecated",
        "superseded"
      ]
    },
    "deciders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "context": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "consequences": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
