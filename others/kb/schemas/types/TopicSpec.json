{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TopicSpec",
  "x-kb-kind": "node",
  "x-kb-group": "user",
  "x-kb-overview": false,
  "x-kb-version": 1,
  "type": "object",
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "aliases": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 100}},
    "domain": {"type": "array", "uniqueItems": true, "items": {"enum": ["A", "B", "C", "D", "E", "F", "G"]}},
    "parent": {"type": ["string", "null"], "pattern": "^e:topic:[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "exclude": {"type": "array", "maxItems": 20, "items": {"type": "string"}},
    "export_llm": {"type": "boolean", "default": false},
    "export_query": {"type": "boolean"}
  },
  "additionalProperties": false
}
