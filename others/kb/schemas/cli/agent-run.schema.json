{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagae-kb/schemas/cli/agent-run.schema.json",
  "title": "kb agent run --json",
  "type": "object",
  "required": ["windows", "claims", "rejected", "queue_left", "is_error", "scope", "by_backend"],
  "properties": {
    "windows": {"type": "integer", "minimum": 0},
    "claims": {"type": "integer", "minimum": 0},
    "rejected": {"type": "integer", "minimum": 0},
    "queue_left": {"type": "integer", "minimum": 0},
    "is_error": {"type": "boolean"},
    "scope": {"enum": ["public", "sensitive"]},
    "by_backend": {"type": "object", "propertyNames": {"enum": ["claude", "codex", "openrouter", "openai_api", "anthropic_api", "local", "sllm"]},
                   "additionalProperties": {"type": "integer", "minimum": 0}},
    "reason": {"type": ["string", "null"]},
    "needs_review": {"type": "integer"},
    "cache_hits": {"type": "integer"},
    "guarded": {"type": "integer"},
    "failed": {"type": "integer"},
    "spent_usd": {"type": "number"},
    "support": {"type": "object"},
    "cross": {"type": "object"},
    "retracted": {"type": "integer"},
    "requeued": {"type": "integer"},
    "codes": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0},
              "description": "needs_review, rejected 항목의 사유 코드별 건수(R_*, E_*). 코드가 둘인 항목은 각 코드에 한 번씩 센다(합계가 항목 수보다 클 수 있다). 원장에는 남지 않는다"},
    "normalized_fields": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0},
                          "description": "두 자리 연도('25년', '25년도')를 인용구의 '(25년)', '25년도' 근거로 연도('2025')로 바꾼 선택 시각 필드 건수"}
  },
  "additionalProperties": true
}
