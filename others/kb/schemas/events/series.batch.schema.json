{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagae-kb/schemas/events/series.batch.schema.json",
  "title": "series.batch",
  "description": "점 묶음(NDJSON, CAS).",
  "type": "object",
  "properties": {
    "series_id": {
      "type": "string",
      "minLength": 1
    },
    "snapshot": {
      "type": "string",
      "minLength": 1
    },
    "parser": {
      "type": "string",
      "minLength": 1
    },
    "points_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "series_id",
    "snapshot",
    "parser",
    "points_sha",
    "count"
  ]
}
