{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagae-kb/schemas/events/source.registered.schema.json",
  "title": "source.registered",
  "description": "소스 등록.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string"
    },
    "class": {
      "type": "string"
    },
    "domain": {
      "type": "array",
      "items": {
        "enum": [
          "A",
          "B",
          "C",
          "D",
          "E",
          "F",
          "G"
        ]
      },
      "uniqueItems": true
    },
    "spec_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "props": {
      "type": "object"
    }
  },
  "required": [
    "id"
  ]
}
