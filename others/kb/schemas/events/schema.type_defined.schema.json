{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagae-kb/schemas/events/schema.type_defined.schema.json",
  "title": "schema.type_defined",
  "description": "타입 정의.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "node",
        "edge"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "schema_json": {
      "type": "object"
    },
    "status": {
      "enum": [
        "provisional",
        "active",
        "deprecated"
      ]
    }
  },
  "required": [
    "name",
    "kind",
    "version",
    "status"
  ]
}
