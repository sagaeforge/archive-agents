{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagae-kb/schemas/events/ticket.close.schema.json",
  "title": "ticket.close",
  "description": "티켓 종료.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "done",
        "unanswerable",
        "blocked_policy"
      ]
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "status"
  ]
}
