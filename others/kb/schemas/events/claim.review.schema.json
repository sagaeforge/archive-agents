{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagae-kb/schemas/events/claim.review.schema.json",
  "title": "claim.review",
  "description": "검증 상태 갱신.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "verification": {
      "enum": [
        "unverified",
        "needs_review",
        "quote_found",
        "parser_derived",
        "first_party"
      ]
    },
    "support_check": {
      "enum": [
        "supported",
        "unsupported"
      ]
    },
    "decided_by": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "verification",
    "decided_by"
  ]
}
