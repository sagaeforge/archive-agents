{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagae-kb/schemas/events/series.define.schema.json",
  "title": "series.define",
  "description": "시계열 정의.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "domain": {
      "type": "array",
      "items": {
        "enum": [
          "A",
          "B",
          "C",
          "D",
          "E",
          "F",
          "G"
        ]
      },
      "uniqueItems": true
    },
    "granularity": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "label",
    "metric"
  ]
}
