{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagae-kb/schemas/events/ticket.open.schema.json",
  "title": "ticket.open",
  "description": "정보 요청.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "integer"
    },
    "urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requester": {
      "type": "string"
    }
  },
  "required": [
    "id",
    "topic",
    "reason"
  ]
}
