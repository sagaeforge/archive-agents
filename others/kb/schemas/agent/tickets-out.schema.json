{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagae-kb/schemas/agent/tickets-out.schema.json",
  "title": "kb_ticket_list 정리",
  "type": "object",
  "properties": {
    "tickets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "topic"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "topic": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "incidents": {
      "$ref": "incidents.schema.json"
    }
  },
  "required": [
    "tickets",
    "incidents"
  ],
  "additionalProperties": true
}
