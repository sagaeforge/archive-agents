{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagae-kb/schemas/agent/incidents.schema.json",
  "title": "incidents (모든 에이전트 출력과 워크플로우 반환값의 필수 필드)",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "kind",
      "detail"
    ],
    "properties": {
      "kind": {
        "enum": [
          "external_send",
          "global_file_change",
          "data_loss",
          "agent_lost",
          "other"
        ]
      },
      "detail": {
        "type": "string"
      },
      "path": {
        "type": "string"
      },
      "at": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
