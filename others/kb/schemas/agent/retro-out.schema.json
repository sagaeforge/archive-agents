{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagae-kb/schemas/agent/retro-out.schema.json",
  "title": "kb-retro 출력",
  "type": "object",
  "properties": {
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "target",
          "change",
          "metric"
        ],
        "properties": {
          "target": {
            "enum": [
              "prompt",
              "cadence",
              "vocabulary",
              "adapter"
            ]
          },
          "change": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          }
        }
      }
    },
    "incidents": {
      "$ref": "incidents.schema.json"
    }
  },
  "required": [
    "proposals",
    "incidents"
  ],
  "additionalProperties": true
}
