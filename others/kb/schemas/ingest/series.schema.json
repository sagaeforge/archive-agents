{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagae-kb/schemas/ingest/series.schema.json",
  "title": "kb-ingest/1 series",
  "description": "결정적 파서만.",
  "type": "object",
  "properties": {
    "item": {
      "const": "series"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "key": {
      "type": "string",
      "minLength": 1
    },
    "metric": {
      "type": "string",
      "minLength": 1
    },
    "unit": {
      "type": "string"
    },
    "label": {
      "type": "string"
    },
    "snapshot": {
      "type": "string",
      "minLength": 1
    },
    "parser": {
      "type": "string",
      "minLength": 1
    },
    "points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "period": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": [
              "string",
              "number"
            ]
          }
        },
        "required": [
          "period",
          "value"
        ]
      }
    },
    "domain": {
      "type": "array",
      "items": {
        "enum": [
          "A",
          "B",
          "C",
          "D",
          "E",
          "F",
          "G"
        ]
      },
      "uniqueItems": true
    }
  },
  "required": [
    "item",
    "key",
    "metric",
    "points",
    "snapshot",
    "parser"
  ],
  "additionalProperties": false
}
