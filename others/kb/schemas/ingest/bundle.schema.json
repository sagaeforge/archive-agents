{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sagae-kb/schemas/ingest/bundle.schema.json",
  "title": "kb-ingest/1 bundle",
  "description": "머리 줄. 묶음당 항목 5,000개 상한.",
  "type": "object",
  "properties": {
    "item": {
      "const": "bundle"
    },
    "contract": {
      "const": "kb-ingest/1"
    },
    "batch_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "producer": {
      "type": "string",
      "pattern": "^(agent|user):[^\\s]+$"
    },
    "domain": {
      "type": "array",
      "items": {
        "enum": [
          "A",
          "B",
          "C",
          "D",
          "E",
          "F",
          "G"
        ]
      },
      "uniqueItems": true
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "ticket": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "item",
    "contract",
    "batch_id",
    "producer"
  ],
  "additionalProperties": false
}
