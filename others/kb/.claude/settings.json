{
  "permissions": {
    "deny": [
      "Bash(rtk init*)",
      "Bash(trail init*)",
      "Bash(trail note*)",
      "Bash(trail upgrade*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/ops/hooks/rtk-guard.sh", "timeout": 10 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/ops/hooks/session-start.sh", "timeout": 150 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "KB=/home/user/sagae-kb-data/runtime/bin/kb; [ -x \"$KB\" ] && [ -z \"$KB_JOB\" ] && \"$KB\" ship --if-dirty --timeout 20; exit 0", "timeout": 25 }
        ]
      }
    ]
  }
}
