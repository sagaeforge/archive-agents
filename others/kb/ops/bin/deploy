#!/usr/bin/env bash
# deploy [--dry-run] [--from-snapshot <tar.gz>]
# 내용 해시 <id>로 runtime/venv-<id>, runtime/share-<id>를 만들고 runtime/venv, runtime/share symlink를 바꾼다.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ -z "${KB_TOOLCHAIN:-}" ] && [ -n "${KB_HOME:-}" ] && [ ! -x "$KB_HOME/runtime/uv/uv" ]; then
  export KB_TOOLCHAIN=/home/user/sagae-kb-data/runtime
fi
. "$here/env.sh"
DRY=0; SNAP=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY=1 ;;
    --from-snapshot) SNAP="${2:?--from-snapshot <tar.gz>}"; shift ;;
    *) echo "알 수 없는 인수: $1" >&2; exit 2 ;;
  esac
  shift
done
SRC="$KB_REPO"
CLEAN=""
if [ -n "$SNAP" ]; then
  [ -f "$SNAP" ] || { echo "스냅샷 없음: $SNAP" >&2; exit 2; }
  base="${KB_TMP:-$KB_HOME/test-tmp/deploy}"
  mkdir -p "$base"
  SRC="$(mktemp -d -p "$base" deploy-snap.XXXXXX)"
  CLEAN="$SRC"
  trap '[ -z "$CLEAN" ] || rm -rf "$CLEAN"' EXIT
  python3 -I - "$SNAP" "$SRC" <<'P'
import sys, tarfile
with tarfile.open(sys.argv[1]) as t:
    t.extractall(sys.argv[2], filter="data")
P
fi
export DEPLOY_SRC="$SRC"

ID="$(python3 -I - "$SRC" <<'P'
import hashlib, os, sys
root = sys.argv[1]
items = ["uv.lock", "src", "schemas", "sources", "prompts",
         "ops/bin/kb-agent-run", "ops/job-settings", ".claude/agents", ".claude/workflows"]
h = hashlib.sha256()
def feed(rel, full):
    h.update(rel.encode() + b"\0")
    with open(full, "rb") as f:
        h.update(hashlib.sha256(f.read()).digest())
for it in items:
    full = os.path.join(root, it)
    if os.path.isfile(full):
        feed(it, full)
    elif os.path.isdir(full):
        for d, ds, fs in os.walk(full):
            ds[:] = sorted(x for x in ds if x != "__pycache__")
            for fn in sorted(fs):
                if fn.endswith(".pyc"):
                    continue
                fp = os.path.join(d, fn)
                feed(os.path.relpath(fp, root), fp)
print(h.hexdigest()[:12])
P
)"
RT="$KB_HOME/runtime"
echo "id: $ID"
echo "원본: $SRC"
echo "설치: $RT/venv-$ID (uv sync --frozen --no-editable --extra serve --extra collect)"
echo "복사: $RT/share-$ID (schemas sources prompts ops/bin/kb-agent-run ops/job-settings .claude/agents .claude/workflows 중 있는 것)"
echo "교체: $RT/venv -> venv-$ID, $RT/share -> share-$ID"
echo "래퍼: $RT/bin/kb, $RT/bin/kb-mcp"
echo "정리: 옛 세대는 2개만 남김"
[ "$DRY" = 1 ] && { echo "(dry-run: 변경 없음)"; exit 0; }

# tmpfs, 9p 거부
p="$KB_HOME"; while [ ! -e "$p" ] && [ "$p" != "/" ]; do p="$(dirname "$p")"; done
case "$(stat -f -c %T "$p")" in tmpfs|v9fs|9p) echo "거부된 파일시스템: $p" >&2; exit 1 ;; esac

mkdir -p "$RT/bin"
V="$RT/venv-$ID"; S="$RT/share-$ID"
if [ ! -f "$V/.complete" ]; then
  rm -rf "$V"
  UV_PROJECT_ENVIRONMENT="$V" uv sync --frozen --no-editable --extra serve --extra collect --project "$SRC"
  touch "$V/.complete"
fi
if [ ! -f "$S/.complete" ]; then
  rm -rf "$S"; mkdir -p "$S"
  for it in schemas sources prompts ops/bin/kb-agent-run ops/job-settings .claude/agents .claude/workflows; do
    if [ -e "$SRC/$it" ]; then
      mkdir -p "$S/$(dirname "$it")"
      cp -a "$SRC/$it" "$S/$it"
    fi
  done
  find "$S" -name __pycache__ -prune -exec rm -rf {} + 2>/dev/null || true
  touch "$S/.complete"
fi
date +%s%N > "$S/.deployed"

for n in kb:kb.cli:main kb-mcp:kb.serve.mcp:main; do
  name="${n%%:*}"; rest="${n#*:}"; mod="${rest%%:*}"; fn="${rest##*:}"
  cat > "$RT/bin/$name.new" <<W
#!/bin/sh
here="\$(cd "\$(dirname "\$0")/.." && pwd)"
export KB_HOME="\$(dirname "\$here")"
export KB_SHARE="\$here/share"
export KB_CLAUDE_BIN='${KB_CLAUDE_BIN}'
exec "\$here/venv/bin/python" -I -c 'import sys; from $mod import $fn; sys.exit($fn())' "\$@"
W
  chmod +x "$RT/bin/$name.new"
  mv -f "$RT/bin/$name.new" "$RT/bin/$name"
done

for k in venv share; do
  ln -sfn "$k-$ID" "$RT/$k.new"
  mv -T "$RT/$k.new" "$RT/$k"
done

# 옛 세대 정리: 현재 + 옛 2세대 유지
python3 -I - "$RT" "$ID" <<'P'
import os, shutil, sys
rt, cur = sys.argv[1:3]
gens = []
for n in os.listdir(rt):
    if n.startswith("share-") and n != "share-" + cur and os.path.isdir(os.path.join(rt, n)):
        try:
            t = int(open(os.path.join(rt, n, ".deployed")).read().strip())
        except Exception:
            t = int(os.stat(os.path.join(rt, n)).st_mtime * 1e9)
        gens.append((t, n[len("share-"):]))
gens.sort(reverse=True)
for _, i in gens[2:]:
    for k in ("venv-", "share-"):
        shutil.rmtree(os.path.join(rt, k + i), ignore_errors=True)
P
echo "배포 완료: $ID"
