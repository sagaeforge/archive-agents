#!/usr/bin/env bash
# Stands in for ssh in the bootstrap tests. It reaches no node: it runs the remote
# command the way sshd would, so the real remote script executes against the fake
# pveum. FAKE_SSH_DOWN=1 refuses the connection. On the call that issues a token,
# FAKE_SSH_LOSE_REPLY=1 loses the connection once the node has finished, and
# FAKE_SSH_CLIENT_GONE=1 loses it before the node writes its reply, and FAKE_SSH_SWALLOW=1
# exits 0 without running it, as a forced command can.
set -euo pipefail

printf 'ssh %s\n' "$*" >>"$FAKE_PVE_STATE/argv.log"

while (($# > 0)); do
  case "$1" in
    -o) shift 2 ;;
    -n)
      exec </dev/null
      shift
      ;;
    *) break ;;
  esac
done

host=$1
shift
record ssh "$host"

if [[ -n ${FAKE_SSH_DOWN:-} ]]; then
  echo "ssh: connect to host $host port 22: Connection refused" >&2
  exit 255
fi

if [[ $1 == bash && -n ${FAKE_SSH_SWALLOW:-} ]]; then
  exit 0
fi

if [[ $1 == bash && -n ${FAKE_SSH_LOSE_REPLY:-} ]]; then
  bash -c "$*" >/dev/null
  echo "client_loop: send disconnect: Broken pipe" >&2
  exit 255
fi

if [[ $1 == bash && -n ${FAKE_SSH_CLIENT_GONE:-} ]]; then
  # Fd 3 is a pipe whose reader has already exited, as sshd leaves a dead session.
  exec 3> >(:)
  wait "$!"
  bash -c "$*" >&3 || true
  echo "client_loop: send disconnect: Broken pipe" >&2
  exit 255
fi

exec bash -c "$*"
