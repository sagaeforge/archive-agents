#!/usr/bin/env bash
# Appends one event to the fakes' shared call log, with the token the local file
# held at that moment. That is what lets the tests place the file swap in the order.
# FAKE_SIGNAL_ON names an event at which the script alone receives FAKE_SIGNAL, the
# way `kill` reaches it, while whatever it is running carries on.
held=$(cut -s -d= -f1 "$PVE_TOKEN_FILE" 2>/dev/null || true)
printf '%s | file=%s\n' "$*" "${held:-none}" >>"$FAKE_PVE_STATE/calls.log"

if [[ $1 == "${FAKE_SIGNAL_ON:-}" ]]; then
  kill "-$FAKE_SIGNAL" "$(<"$FAKE_PVE_STATE/script.pid")"
fi
